{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: assembleDebug",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Gradle: test",
      "type": "shell",
      "command": "./gradlew test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Gradle: installDebug",
      "type": "shell",
      "command": "./gradlew installDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ADB: devices",
      "type": "shell",
      "command": "adb devices",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ADB: logcat",
      "type": "shell",
      "command": "adb logcat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
